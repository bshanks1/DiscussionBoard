@page "/Discussions/Create/{forumid}"
@model DiscussionBoard.Pages.Discussions.Create


<!DOCTYPE html>

<html>
<head>
    <title>@{ ViewData["Title"] = "Create"; }</title>
</head>
<body>
<div id="form">
    <form method="post">
        <div class="mb-3">
            <label>Edit Thread Title</label>
            <input type="text" id="Title" name="Title" value="Enter Title Here.">
        </div>
        <div class="mb-3">
            <label>Edit Thread Title</label>
            <textarea type="text" id="Content" name="Content" rows="5" cols="33">Enter Text Here.</textarea>
        </div>
        <button class="btn btn-primary">Submit</button>
    </form>
</div>
</body>
</html>
