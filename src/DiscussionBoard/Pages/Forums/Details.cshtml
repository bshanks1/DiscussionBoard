@page "/Forum/{forumid}"
@using DiscussionBoard.Models
@model DiscussionBoard.Pages.Forums.Details

@{ ViewData["Title"] = "Details"; }
<h1>@Model.forum.Name</h1>
@{
    List<int> usedids = new List<int>();
    usedids.Add(0);

    foreach (var thread in Model.forum.DiscussionThreads)
    {
        if (!usedids.Contains(thread.Id))
        {
            DiscussionThreadUserManager threadUserManager = new DiscussionThreadUserManager(thread, Model.userManager, Model.ApplicationAuthorizationService);
            <partial name="/Pages/Forums/_ThreadCard.cshtml" model="threadUserManager" />
            usedids.Add(thread.Id);
        }
    }
}
