{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=Data/discussion.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SerilogSettings": {
    "Formatter" : "new RenderedCompactJsonFormatter()",
    "Path" : "logPath",
    "RollingInterval" : "RollingInterval.Day",
    "Shared" : "True"
}
}
